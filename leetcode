func addTwoNumbers(l1 *ListNode, l2 *ListNode) *ListNode {
    add1:=0
    sum:=0
    var result,head *ListNode
    for l1!=nil || l2!=nil{
        sum+=add1
        if l1!=nil{
            sum +=l1.Val
            l1=l1.Next
        }
        if l2!=nil{
            sum+=l2.Val
            l2=l2.Next
        }
        add1=sum/10
        if sum>9{
            sum =sum-10
        }
        
        if result==nil{
            head=&ListNode{Val:sum}
            result=head
        }else{
            result.Next=&ListNode{Val:sum}
            result=result.Next
        }
        sum=0
    }
    if add1==1{
        result.Next=&ListNode{Val:1}

    }
    return head
}
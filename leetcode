   func search (nums[]int,target int) int{
       left :=0
       right :=len(nums)-1
       for left<=right {
           mid :=left+(right-left)/2
           if nums[mid]>=target{
               right=mid-1
           }else{
               left=mid+1
           }
       }
       return left
   }

   func searchRange(nums []int, target int) []int {
       start :=search(nums,target)
       if start==len(nums) ||nums[start] !=target{
           return []int{-1,-1}
       }
       end :=search(nums,target+1)-1
       return []int{start,end}
   }

   func findAnagrams(s string, p string) []int {
       k :=len(p)
       chars :=[26]int{}
       charp :=[26]int{}
       result :=[]int{}
       for _,v:=range p {
           charp[v-'a']++
       }
       for right,v:=range s{
           chars[v-'a']++
           left :=right-k+1
           if left<0 {
               continue
           }
           if chars==charp{
               result =append(result,left)
           }
           chars[s[left]-'a']--
       }
       return result
   }


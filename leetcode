 */
func getDecimalValue(head *ListNode) int {
    res :=0
    for head !=nil{
        res=res*2+head.Val
        head = head.Next
    }
    return res
}

/**
 * Definition for singly-linked list.
 * type ListNode struct {
 *     Val int
 *     Next *ListNode
 * }
 */
func getIntersectionNode(headA, headB *ListNode) *ListNode {
    p:=headA
    q:=headB
    for p!=q{
        if p!=nil{
            p=p.Next
        }else{
            p=headB
        }
        if q!=nil{
            q=q.Next
        }else{
            q=headA
        }
    }
    return q
}


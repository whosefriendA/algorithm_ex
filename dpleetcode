func climbStairs(n int) int {
    if n==0{
        return 0
    }else if n==1{
        return 1
    }else if n==2{
        return 2
    }
    f1:=1
    f2:=2
    fv:=0
    for i:=0;i<n-2;i++{
        fv=f1+f2
        f1=f2
        f2=fv
    }
    return fv
}

